# Copy to .env and adjust. docker-compose and the Django settings both read this file.

# --- Django ---------------------------------------------------------------
# Active settings module: development | production
DJANGO_ENV=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=UTC
# Production only: set to false to try the production stack locally over plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=true
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=task_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# "db" inside docker-compose; localhost:5433 when running Django on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# --- Redis (cache, rate limiting, Celery broker) ---------------------------
# "redis://redis:6379/0" inside docker-compose.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Email ----------------------------------------------------------------
# Development prints emails to the console. Production uses SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Task Manager <noreply@example.com>

# --- Frontend (Vite) -------------------------------------------------------
# Base URL of the backend API as seen from the browser.
VITE_API_URL=http://localhost:8000/api
