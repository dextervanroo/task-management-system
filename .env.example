# Copy to .env and adjust. docker-compose and the Django settings both read this file.

# --- Django ---------------------------------------------------------------
# Active settings module: development | production
DJANGO_ENV=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=task_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# "db" inside docker-compose; localhost:5433 when running Django on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# --- Redis (cache, rate limiting, Celery broker) ---------------------------
# "redis://redis:6379/0" inside docker-compose.
REDIS_URL=redis://localhost:6379/0
